# FineWeb-Edu: plain web prose, neither math nor code. The third corpus, so the
# math-vs-code delta can be read against a neutral control rather than only
# against each other.
#
# Loads from a LOCAL 1200-row parquet (data.py pins REAP_FINEWEB_PARQUET), so
# calibration needs no network. 256 samples fits inside it with room to spare.
DATASET=HuggingFaceFW/fineweb-edu
DS=fineweb-edu
SUFFIX=fw256
SWEEP=reap_fineweb
CALIB_BS=8
CALIB_NB=32   # 8x32 = 256 calibration samples @ L256
