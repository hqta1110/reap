# evol-codealpaca-v1, the ORIGINAL REAP calibration corpus. This campaign exists
# only to complete cells missing from the 2026-09-12 codealpaca run, so every
# knob must match what those checkpoints were actually built with -- notably
# 4x32=128 samples, NOT the 8x32=256 the math and fineweb campaigns use.
# Arm names are bare (reap25/reap50): the existing cells own those names.
DATASET=theblackcat102/evol-codealpaca-v1
DS=evol-codealpaca-v1
SUFFIX=
SWEEP=reap_code
CALIB_BS=4
CALIB_NB=32
