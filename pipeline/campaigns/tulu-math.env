# Calibration corpus for this campaign. Sourced by the shared drivers in
# pipeline/, which are corpus-agnostic.
DATASET=allenai/tulu-3-sft-personas-math   # HF name passed to prune.py
DS=tulu-3-sft-personas-math                # artifacts/<model>/<DS>/ subdirectory
SUFFIX=math256                             # arm names: reap25_$SUFFIX / reap50_$SUFFIX
SWEEP=reap_tulu                            # roots.conf key used when publishing
CALIB_BS=8
CALIB_NB=32   # 8x32 = 256 calibration samples @ L256
