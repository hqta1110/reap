# Machine-local paths. Copy to pipeline/reap.env and edit; reap.env is gitignored
# so each machine keeps its own. THIS FILE IS THE ONLY THING THAT SHOULD DIFFER
# BETWEEN MACHINES -- if you find yourself editing a .sh to move a path, add the
# knob here instead.

# This repo (REAP source + prune_reap_any.sh). Artifacts live under $REAP_ROOT/artifacts.
REAP_ROOT=${REAP_ROOT:-$HOME/reap}

# Python that can run src/reap/prune.py (transformers >= 5.16 for Qwen3-MoE/Gemma-4).
REAP_PY=${REAP_PY:-$REAP_ROOT/.venv-reap/bin/python}

# Checkout of the offline accuracy harness (tools/run_offline_pipeline.py).
EVAL_REPO=${EVAL_REPO:-$HOME/moe-eval-offline}

# Scratch for campaign state: queues, logs, per-GPU-pair locks.
REAP_STATE=${REAP_STATE:-$HOME/.reap-campaigns}

# Per-model eval venvs. These differ because the models need different vLLM
# versions -- gemma-4 needs 0.29, the Qwen/GLM stack runs 0.18.1. One venv for
# all four is the usual cause of a silent config-key/tokenizer drift.
VENV_QWEN=${VENV_QWEN:-$HOME/new-efficient-moe/.venv/bin/python}
VENV_GLM=${VENV_GLM:-$HOME/SERE-glm/.venv/bin/python}
VENV_GEMMA4=${VENV_GEMMA4:-$HOME/gemma4-bench/.venv/bin/python}

# HuggingFace cache holding the BASE model snapshots to prune from.
HF_HUB=${HF_HUB:-$HOME/.cache/huggingface/hub}

# GPU pairs the scheduler may allocate (TP=2 each).
GPU_PAIRS=${GPU_PAIRS:-"0,1 2,3"}

# Local parquet for fineweb-edu calibration, so calibration needs no network.
REAP_FINEWEB_PARQUET=${REAP_FINEWEB_PARQUET:-$REAP_ROOT/data/fineweb_edu_calibration.parquet}
